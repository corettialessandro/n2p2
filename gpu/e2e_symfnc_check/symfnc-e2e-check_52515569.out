=== Staging input.nn/scaling.data/weights.*.data (converged 100-epoch potential) ===

=== [1/3] Build libnnpgpu.a (GPU=1) ===
cp GpuKalmanFilter.h GpuQeqSolver.h GpuForces.h GpuSymmetryFunction.h GpuEwaldReal.h GpuNeuralNetwork.h GpuElecForces.h ../../include
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuEwaldReal.o -c GpuEwaldReal.cu
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuNeuralNetwork.o -c GpuNeuralNetwork.cu
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuElecForces.o -c GpuElecForces.cu
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuKalmanFilter.o -c GpuKalmanFilter.cu
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuQeqSolver.o -c GpuQeqSolver.cu
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuForces.o -c GpuForces.cu
nvcc -O3 -std=c++14 -arch=sm_80 -I./ -I../../include -o GpuSymmetryFunction.o -c GpuSymmetryFunction.cu
ar -rcsv libnnpgpu.a GpuEwaldReal.o GpuNeuralNetwork.o GpuElecForces.o GpuKalmanFilter.o GpuQeqSolver.o GpuForces.o GpuSymmetryFunction.o
a - GpuEwaldReal.o
a - GpuNeuralNetwork.o
a - GpuElecForces.o
a - GpuKalmanFilter.o
a - GpuQeqSolver.o
a - GpuForces.o
a - GpuSymmetryFunction.o
cp libnnpgpu.a ../../lib

